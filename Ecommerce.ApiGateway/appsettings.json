{
  "ReverseProxy": {
    "Routes": {
      "auth-route": {
        "ClusterId": "user-cluster",
        "Match": { "Path": "/api/v1/auth/{**catch-all}" }
      },
      "user-route": {
        "ClusterId": "user-cluster",
        "Match": { "Path": "/api/v1/users/{**catch-all}" }
      },
      "product-route": {
        "ClusterId": "product-cluster",
        "Match": { "Path": "/api/v1/products/{**catch-all}" }
      },
      "cart-route": {
        "ClusterId": "cart-cluster",
        "Match": { "Path": "/api/v1/cart/{**catch-all}" }
      },
      "order-route": {
        "ClusterId": "order-cluster",
        "Match": { "Path": "/api/v1/orders/{**catch-all}" }
      }
    },
    "Clusters": {
      "user-cluster": {
        "HttpClient": { "DangerousAcceptAnyServerCertificate": true },
        "Destinations": {
          "destination1": { "Address": "https://localhost:5001" }
        }
      },
      "product-cluster": {
        "HttpClient": { "DangerousAcceptAnyServerCertificate": true },
        "Destinations": {
          "destination1": { "Address": "https://localhost:5002" }
        }
      },
      "cart-cluster": {
        "HttpClient": { "DangerousAcceptAnyServerCertificate": true },
        "Destinations": {
          "destination1": { "Address": "https://localhost:5003" }
        }
      },
      "order-cluster": {
        "HttpClient": { "DangerousAcceptAnyServerCertificate": true },
        "Destinations": {
          "destination1": { "Address": "https://localhost:5004" }
        }
      }
    }
  },
  "Logging": {
    "LogLevel": {
      "Default": "Information",
      "Microsoft.AspNetCore": "Warning"
    }
  },
  "AllowedHosts": "*"
}